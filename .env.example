# HireFlow Environment Configuration Example
# Copy this file to .env or configure appsettings.json/environment variables accordingly.

# ASP.NET Core Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Connection Strings
# For SQL Server LocalDB: "Server=(localdb)\\mssqllocaldb;Database=HireFlowDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
# For SQL Express: "Server=.\\SQLEXPRESS;Database=HireFlowDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
ConnectionStrings__DefaultConnection=Server=(localdb)\\mssqllocaldb;Database=HireFlowDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# JWT Authentication Secrets (Must be at least 32 characters in production)
Jwt__Secret=HireFlow_Super_Secure_Secret_Key_For_Development_32_Chars_Long
Jwt__Issuer=HireFlowApi
Jwt__Audience=HireFlowApp
Jwt__ExpiryMinutes=1440

# File Storage Configuration
FileStorage__StoragePath=storage/cvs
FileStorage__MaxFileSizeMb=5

# Payment Gateway Configuration (Simulator for Dev)
PaymentGateway__Provider=DevSimulator
PaymentGateway__EnableSimulation=true

# Admin Seed Configuration (Initial provisioned Admin)
AdminSeed__Email=admin@hireflow.com
AdminSeed__Password=Admin@HireFlow2026!
AdminSeed__FullName=HireFlow Administrator
